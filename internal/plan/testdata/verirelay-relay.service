# Generated by deploy from /home/ubuntu/docker/verirelay/relay/deploy.toml. Change that file and run deploy up.
[Unit]
Description=VeriRelay CVM (rel-2026.10.30-1, 8 vCPU)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/ubuntu/docker/verirelay/relay
ExecStart=/usr/bin/qemu-system-x86_64 \
  -enable-kvm -cpu EPYC-v4 -smp 8 -m 16G \
  -machine q35,confidential-guest-support=sev0,memory-encryption=sev0,memory-backend=ram0,vmport=off \
  -object memory-backend-memfd,id=ram0,size=16G,share=on \
  -object sev-snp-guest,id=sev0,cbitpos=51,reduced-phys-bits=1,kernel-hashes=on,policy=0x30000,host-data=BDPXy4jtPljlygZjswM9qI/P3CPPR3r/yFhnGhba+tY= \
  -bios /home/ubuntu/docker/verirelay/relay/releases/rel-2026.10.30-1/OVMF.fd -kernel /home/ubuntu/docker/verirelay/relay/releases/rel-2026.10.30-1/vmlinuz -initrd /home/ubuntu/docker/verirelay/relay/releases/rel-2026.10.30-1/initrd.img \
  -append "console=ttyS0 quiet panic=1" \
  -drive file=/home/ubuntu/docker/verirelay/relay/config.img,if=virtio,format=raw,readonly=on \
  -display none -monitor none -serial stdio \
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:18081-:8080 -device virtio-net-pci,netdev=net0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
